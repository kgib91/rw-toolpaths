<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>netstandard2.0</TargetFramework><AssemblyName>Clipper1</AssemblyName><Nullable>disable</Nullable>
    <!-- Ordinary medial preparation uses this integer kernel during desktop
         Debug generation too. Retain symbols without disabling JIT optimization;
         an explicit /p:Optimize=false still supports instruction-level debugging. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
