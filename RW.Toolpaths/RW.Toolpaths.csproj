<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RW.Toolpaths</AssemblyName>
    <RootNamespace>RW.Toolpaths</RootNamespace>
    <!-- Interactive geometry must retain compiler/JIT optimization in Debug too.
         Symbols and diagnostic logging remain available; /p:Optimize=false can
         still opt into unoptimized instruction-level debugging when required. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned 1.4.0 source and identity; Shared uses this same project. -->
    <ProjectReference Include="..\vendor\Clipper2\Clipper2Lib.csproj" />
    <ProjectReference Include="..\vendor\Clipper1\Clipper1.csproj" />
    <PackageReference Include="MIConvexHull" Version="1.1.19.1019" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="native/vcarve_cuda/disc_witness.cu"
                      LogicalName="RW.Toolpaths.Milling.Acceleration.disc_witness.cu" />
  </ItemGroup>

  <!-- Bare-name P/Invoke resolves beside the managed assembly. Project content
       under runtimes/ is not a NuGet runtime asset and adds no native deps entry. -->
  <ItemGroup>
    <Content Include="runtimes\win-x64\native\clipper2medial.dll" Link="clipper2medial.dll" Condition="Exists('$(MSBuildThisFileDirectory)runtimes/win-x64/native/clipper2medial.dll')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="runtimes\linux-x64\native\libclipper2medial.so" Link="libclipper2medial.so" Condition="Exists('$(MSBuildThisFileDirectory)runtimes/linux-x64/native/libclipper2medial.so')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="runtimes\osx-x64\native\libclipper2medial.dylib" Link="libclipper2medial.dylib" Condition="Exists('$(MSBuildThisFileDirectory)runtimes/osx-x64/native/libclipper2medial.dylib')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="runtimes/win-x64/native/boostvoronoi.dll"
             Link="boostvoronoi.dll" CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('$(MSBuildThisFileDirectory)runtimes/win-x64/native/boostvoronoi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="runtimes/linux-x64/native/libboostvoronoi.so"
             Link="libboostvoronoi.so" CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('$(MSBuildThisFileDirectory)runtimes/linux-x64/native/libboostvoronoi.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="runtimes/osx-x64/native/libboostvoronoi.dylib"
             Link="libboostvoronoi.dylib" CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('$(MSBuildThisFileDirectory)runtimes/osx-x64/native/libboostvoronoi.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    BuildBoostVoronoi: opt-in target that compiles the native wrapper via CMake.

    Usage (from RW.Toolpaths directory):
      Windows:  dotnet msbuild -t:BuildBoostVoronoi
      Linux:    dotnet msbuild -t:BuildBoostVoronoi

    Prerequisites:
      - CMake >= 3.16 on PATH
      - Boost headers installed (apt install libboost-dev  /  choco install boost-msvc-14.3)
      - A C++17 compiler (MSVC on Windows, g++/clang++ on Linux)
  -->
  <!--
    BuildBoostVoronoi: calls setup-native.ps1 (Windows) or setup-native.sh (Linux/macOS).
    The script handles Boost header discovery/download then runs cmake.

    Usage:
      dotnet msbuild -t:BuildBoostVoronoi
      dotnet msbuild -t:BuildBoostVoronoi -p:BoostIncludeDir=C:\local\boost_1_87_0
  -->
  <Target Name="BuildBoostVoronoi">
    <PropertyGroup>
      <_NativeDir>$(MSBuildThisFileDirectory)native</_NativeDir>
      <_BoostFlag Condition="'$(BoostIncludeDir)' != ''">-BoostIncludeDir &quot;$(BoostIncludeDir)&quot;</_BoostFlag>
      <_BoostFlag Condition="'$(BoostIncludeDir)' == ''"></_BoostFlag>
    </PropertyGroup>

    <!-- Windows -->
    <Exec Condition="'$(OS)' == 'Windows_NT'"
          Command="powershell -ExecutionPolicy Bypass -File &quot;$(_NativeDir)\setup-native.ps1&quot; $(_BoostFlag)"
          WorkingDirectory="$(_NativeDir)" />

    <!-- Linux / macOS -->
    <Exec Condition="'$(OS)' != 'Windows_NT'"
          Command="bash &quot;$(_NativeDir)/setup-native.sh&quot; $(BoostIncludeDir != '' ? '--boost-dir $(BoostIncludeDir)' : '')"
          WorkingDirectory="$(_NativeDir)" />
  </Target>


  <ItemGroup>
    <!-- Opt-in namespace logging; handlers skip disabled diagnostic interpolation. -->
    <Using Include="RW.Diagnostics.DiagnosticConsole" Alias="Console" />
    <ProjectReference Include="../../rw-csg/RW.Diagnostics/RW.Diagnostics.csproj" />
  </ItemGroup>

</Project>
